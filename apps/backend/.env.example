# Supabase Supavisor *transaction* pooler (port 6543) — runtime queries via
# Hyperdrive, and also used directly by `prisma db seed`/Prisma Studio.
# `?pgbouncer=true` disables Prisma's prepared-statement caching, required
# against any PgBouncer-compatible pooler (Supavisor included) or queries
# intermittently fail with "prepared statement ... already exists".
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"

# Supabase Supavisor *session* pooler (port 5432) — used only by `prisma migrate`.
# The true direct host (db.[project-ref].supabase.co) is IPv6-only and
# unreachable from networks without IPv6 egress, so use the session-mode
# pooler instead (IPv4, supports DDL unlike the transaction-mode pooler above).
# Also needs ?pgbouncer=true for the same prepared-statement reason.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres?pgbouncer=true"
