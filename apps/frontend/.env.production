# Inlined into the client bundle at build time — both values are safe to be
# public (API base URL, Turnstile *site* key, never the secret key).
NEXT_PUBLIC_API_URL="https://api.talento.camarapetrolera.app"
# Cloudflare's published "always passes" test site key — swap for the real
# Turnstile site key once the account is provisioned (paired with the backend's
# TURNSTILE_SECRET_KEY, currently also the matching test secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEv7lij_vbTzMgUz
